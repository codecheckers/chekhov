# Copy to .env (gitignored) and fill in. Never commit real tokens.

# Fine-grained personal access token of the bot user, created with
#   resource owner:     codecheckers
#   repository access:  only codecheckers/testing-dev-register
#   permissions:        Issues read and write, Contents read, Metadata read
#                       (Pull requests read and write once `register` exists)
# See docs/github-token.md, which also says why this is not a classic token.
CHEKHOV_GH_ACCESS_TOKEN=

# Shared secret, must match the webhook secret configured on the target repo.
# Invent one: openssl rand -hex 32
CHEKHOV_GH_SECRET_TOKEN=

# Bot account and target repo (defaults are in config/settings-development.yml)
CHEKHOV_BOT_GH_USER=chekhovbot
CHEKHOV_TARGET_REPO=codecheckers/testing-dev-register

# development | production
CHEKHOV_ENV=development
