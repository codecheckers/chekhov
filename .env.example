# Copy to .env (gitignored) and fill in. Never commit real tokens.

# Personal access token of the bot user, scopes:
#   public_repo, repo:invite, read:org, read:user
CHEKHOV_GH_ACCESS_TOKEN=

# Shared secret, must match the webhook secret configured on the target repo
CHEKHOV_GH_SECRET_TOKEN=

# Bot account and target repo (defaults are in config/settings-development.yml)
CHEKHOV_BOT_GH_USER=chekhovbot
CHEKHOV_TARGET_REPO=codecheckers/testing-dev-register

# development | production
CHEKHOV_ENV=development
